# Copie para .env e preencha apenas a cópia local.
# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelo de chat e de embedding, no formato provedor:modelo do init_chat_model / init_embeddings
MODEL=google_genai:gemini-3.5-flash-lite
EMBEDDINGS=google_genai:gemini-embedding-2

# Limites do plano gratuito usados pelos limitadores (requisições e tokens por minuto)
MODEL_RPM=12
EMBEDDINGS_TPM=25000
